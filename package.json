{
  "name": "@zhongmiao/ngx-puzzle",
  "version": "21.0.0",
  "private": false,
  "packageManager": "npm@11.4.2",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": "^11.4.2"
  },
  "author": "ark65<liuwufangzhou@gmail.com>,<liuwufangzhou@qq.vip.com>",
  "license": "MIT",
  "keywords": [
    "angular",
    "ngx",
    "dashboard",
    "drag-and-drop",
    "drag drop",
    "builder",
    "editor",
    "canvas",
    "grid",
    "echarts",
    "visualization",
    "data-visualization",
    "bi",
    "low-code",
    "library",
    "component",
    "signals",
    "standalone",
    "tethys",
    "chart",
    "table",
    "text",
    "control",
    "看板",
    "拖拽",
    "可视化",
    "仪表盘",
    "组件库",
    "图表",
    "表格",
    "文本",
    "控件"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "ng": "ng",
    "build:docs": "docgeni build",
    "start": "ng serve",
    "build": "npm run build:lib && node scripts/build-schematics.js && npm run build:styles && npm run build:pkgdocs && npm run copy:icons",
    "build:lib": "node scripts/build-production.js",
    "build:lib:dev": "ng build puzzle --configuration production",
    "build:styles": "cpx \"./projects/puzzle/src/**/*.scss\" dist/puzzle",
    "build:pkgdocs": "cpx \"CHANGELOG.md README.md LICENSE\" dist/puzzle",
    "start:docs": "docgeni serve --port 4600",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "wpm release --release-branch-format release-auto-v{{version}}",
    "release:select": "node scripts/release.js -y",
    "prerelease": "npm run build",
    "changelog": "conventional-changelog -p conventionalcommits -r 1 -i CHANGELOG.md -s",
    "changelog:all": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s -r 0",
    "postrelease": "npm run changelog && git add CHANGELOG.md && git commit -m \"docs(changelog): update changelog\" || echo 'no changelog changes' && git push",
    "publish:dist": "cd dist/puzzle && npm publish --access public",
    "prepare": "husky install",
    "copy:icons": "cp -r ./node_modules/@tethys/icons/defs ./dist/puzzle/assets/icons"
  },
  "dependencies": {
    "@angular/animations": "21.2.8",
    "@angular/cdk": "21.2.6",
    "@angular/common": "21.2.8",
    "@angular/compiler": "21.2.8",
    "@angular/core": "21.2.8",
    "@angular/forms": "21.2.8",
    "@angular/platform-browser": "21.2.8",
    "@angular/platform-browser-dynamic": "21.2.8",
    "@angular/router": "21.2.8",
    "@tethys/icons": "1.4.50",
    "@tethys/cdk": "21.0.0",
    "ag-grid-angular": "^35.0.0",
    "ag-grid-community": "^35.0.0",
    "echarts": "6.0.0",
    "lodash": "4.18.1",
    "ngx-tethys": "21.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "0.15.1"
  },
  "schematics": "projects/puzzle/schematics/collection.json",
  "devDependencies": {
    "@angular-builders/custom-webpack": "21.0.3",
    "@angular/build": "21.2.7",
    "@angular-devkit/build-angular": "21.2.7",
    "@angular-eslint/builder": "21.0.0",
    "@angular-eslint/eslint-plugin": "21.0.0",
    "@angular-eslint/eslint-plugin-template": "21.0.0",
    "@angular-eslint/template-parser": "21.0.0",
    "@angular/cli": "21.2.7",
    "@angular/compiler-cli": "21.2.8",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@docgeni/cli": "2.7.0",
    "@docgeni/template": "2.7.0",
    "@types/lodash": "4.17.24",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitest/coverage-v8": "^4.0.8",
    "conventional-changelog-cli": "^5.0.0",
    "cpx": "^1.5.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^7.0.4",
    "jsdom": "^27.0.0",
    "ng-packagr": "21.2.2",
    "prettier": "^3.6.2",
    "rollup-plugin-strip-code": "0.2.8",
    "terser-webpack-plugin": "5.3.14",
    "typescript": "5.9.3",
    "vitest": "^4.0.8"
  }
}
